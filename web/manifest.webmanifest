{
  "name": "Emvryx",
  "short_name": "Emvryx",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#07080D",
  "theme_color": "#07080D",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "description": "Emvryx: your AI assistant",
  "scope": "/",
  "id": "/",
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "New chat",
      "url": "/?pwa=new",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "VryxCode",
      "short_name": "VryxCode",
      "url": "/?pwa=code",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Talk to Emvryx",
      "short_name": "Talk",
      "url": "/?pwa=voice",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "file_handlers": [
    {
      "action": "/?pwa=file",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt",
          ".md"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
