// The app's icon (the window icon too: webview loads IDI_APPLICATION) and the details Windows shows in the file's Properties
#define IDI_APPLICATION 32512
IDI_APPLICATION ICON "emvryx.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Emvryx"
      VALUE "FileDescription", "Emvryx"
      VALUE "ProductName", "Emvryx"
      VALUE "OriginalFilename", "Emvryx.exe"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
