<!-- A theme is a bundle of look settings Android applies to a screen. -->
<resources>
    <!-- Only the window behind the Compose screens; the colours themselves live in ui/theme/Theme.kt -->
    <style name="Theme.Emvryx" parent="android:Theme.Material.NoActionBar">
        <!-- Window colour shown before the app draws anything, so there is no white flash on start. -->
        <item name="android:windowBackground">@color/bg</item>
        <!-- Transparent top and bottom system bars, so the app draws edge to edge behind them. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
