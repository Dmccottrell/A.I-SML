<?xml version="1.0" encoding="utf-8"?>
<!-- android_quick_launch: the widget's rounded dark card -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Fill colour: #AARRGGBB, so F2 is about 95 percent opaque, then a very dark blue. -->
    <solid android:color="#F20F1119" />
    <!-- Round the corners. -->
    <corners android:radius="28dp" />
    <!-- A thin violet border, about 40 percent opaque (66 in hex). -->
    <stroke android:width="1dp" android:color="#668B5CF6" />
</shape>
